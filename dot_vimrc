set notermguicolors
set background=dark

set mouse=a
set number
set relativenumber
set tabstop=4
set shiftwidth=4
set autoindent
set smartindent
set noexpandtab

filetype plugin on
syntax on

filetype indent on

nnoremap - :Explore<cr>
xnoremap - :Explore<cr>

" Tmux navigation

noremap <silent> <c-h> :<C-U>TmuxNavigateLeft<cr>
noremap <silent> <c-j> :<C-U>TmuxNavigateDown<cr>
noremap <silent> <c-k> :<C-U>TmuxNavigateUp<cr>
noremap <silent> <c-l> :<C-U>TmuxNavigateRight<cr>

let g:Netrw_UserMaps = [['<c-l>', '<C-U>TmuxNavigateRight<cr>']]

function! s:VimNavigate(dir)
	try
		execute 'wincmd ' . a:dir
	catch
		echohl ErrorMsg | echo 'E11: Invalid in command-line window; <cr> executes, CTRL-C quits: wincmd k' | echohl None
	endtry
endfunction

if empty($TMUX)
	command! TmuxNavigateLeft call s:VimNavigate('h')
	command! TmuxNavigateDown call s:VimNavigate('j')
	command! TmuxNavigateUp call s:VimNavigate('k')
	command! TmuxNavigateRight call s:VimNavigate('l')
	finish
endif

command! TmuxNavigateLeft call s:TmuxAwareNavigate('h')
command! TmuxNavigateDown call s:TmuxAwareNavigate('j')
command! TmuxNavigateUp call s:TmuxAwareNavigate('k')
command! TmuxNavigateRight call s:TmuxAwareNavigate('l')

let s:dir_to_pane = {'h': 'left', 'j': 'bottom', 'k': 'top', 'l': 'right'}

function! s:TmuxCommand(args)
	let cmd = 'tmux -S ' . split($TMUX, ',')[0] . ' ' . a:args
	let l:x = &shellcmdflag
	let &shellcmdflag = '-c'
	let retval = system(cmd)
	let &shellcmdflag = l:x
	return retval
endfunction

function! s:ShouldForwardToTmux(is_edge)
	if s:TmuxCommand("display-message -p '#{window_zoomed_flag}'") == 1
		return 0
	endif
	return a:is_edge
endfunction

function! s:TmuxAwareNavigate(dir)
	let nr = winnr()
	call s:VimNavigate(a:dir)
	if s:ShouldForwardToTmux(nr == winnr())
		let args = 'select-pane -t ' . shellescape($TMUX_PANE) . ' -' . tr(a:dir, 'hjkl', 'LDUR')
		let args = 'if -F "#{pane_at_' . s:dir_to_pane[a:dir] . '}" "" "' . args . '"'
		silent call s:TmuxCommand(args)
	endif
endfunction
