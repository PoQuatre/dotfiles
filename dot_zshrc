# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

custom_paths=(
	"/usr/lib/ccache"
	"$HOME/.spicetify"
	"$HOME/.config/tmux/plugins/t-smart-tmux-session-manager/bin"
	"$HOME/.local/funcheck/host"
	"$HOME/.local/bin"
)

for p in $custom_paths; do
	if [ -d "$p" ]; then
		export PATH="$p:$PATH"
	fi
done
unset custom_paths

export SHELL=$(which zsh)

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

HIST_STAMPS='yyyy-mm-dd'

# Uncomment the following line if pasting URLs and other text is messed up.
# DISABLE_MAGIC_FUNCTIONS="true"

plugins=(zsh-autosuggestions fast-syntax-highlighting zsh-edit)

if command -v asdf &>/dev/null; then
	export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
	fpath=("${ASDF_DATA_DIR:-$HOME/.asdf}/completions" $fpath)
fi

source $ZSH/oh-my-zsh.sh

# User configuration

if command -v less &>/dev/null; then
	export LESS='-R --mouse --wheel-lines=3 --tabs=1,5'
fi

if command -v vim &>/dev/null; then
	export EDITOR=vim
elif command -v vi &>/dev/null; then
	export EDITOR=vi
else
	export EDITOR=nano
fi

alias cl=clear

if command -v chezmoi &>/dev/null; then
	alias cm=chezmoi

	alias cmg='chezmoi git --'
	alias cmgs='chezmoi git -- status'
	alias cmga='chezmoi git -- add'
	alias cmgaa='chezmoi git -- add .'
	alias cmgc='chezmoi git -- commit'
	alias cmgcm='chezmoi git -- commit -m'
	alias cmgca='chezmoi git -- commit --amend'
	alias cmgd='chezmoi git -- diff'
	alias cmgds='chezmoi git -- diff --cached'
	alias cmgr='chezmoi git -- restore'
	alias cmgrs='chezmoi git -- restore --staged'
	alias cmgl="chezmoi git -- log"
	alias cmgll="chezmoi git -- log --oneline"
	alias cmglg="chezmoi git -- log --graph"
	alias cmgllg="chezmoi git -- log --oneline --graph"
fi

if command -v git &>/dev/null; then
	alias gcl='git clone'
	alias gs='git status'
	alias ga='git add'
	alias gaa='git add .'
	alias gc='git commit'
	alias gcm='git commit -m'
	alias gca='git commit --amend'
	alias gd='git diff'
	alias gds='git diff --cached'
	alias gr='git restore'
	alias grs='git restore --staged'
	alias gl="git log"
	alias gll="git log --oneline"
	alias glg="git log --graph"
	alias gllg="git log --oneline --graph"
fi

if command -v valgrind &>/dev/null; then
	alias vg="valgrind"
fi

if command -v gdb &>/dev/null; then
	alias gdba="gdb --args"
fi

if command -v batcat &>/dev/null && ! command -v bat &>/dev/null; then
	alias bat=batcat
fi
if command -v bat &>/dev/null; then
	export BAT_THEME="Catppuccin Mocha"
	export MANPAGER="sh -c 'sed -u -e \"s/\\x1B\[[0-9;]*m//g; s/.\\x08//g\" | bat -p -lman'"
fi

if command -v fzf &>/dev/null; then
	source <(fzf --zsh)

	export FZF_DEFAULT_OPTS="
		--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
		--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
		--color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
		--color=selected-bg:#45475a
		--bind='ctrl-y:preview-up,ctrl-e:preview-down'
		--bind='ctrl-b:preview-page-up,ctrl-f:preview-page-down'
		--bind='ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down'
		--bind='shift-up:preview-top,shift-down:preview-bottom'
		--bind='alt-k:half-page-up,alt-j:half-page-down'"

	export FZF_CTRL_T_OPTS="
		--walker-skip .git,node_modules,target
		--preview 'bat -n --color=always {}'
		--bind 'ctrl-/:change-preview-window(down|hidden|)'
		--header 'Press CTRL-/ to change preview window'"

	export FZF_CTRL_R_OPTS="
		--bind 'ctrl-y:execute-silent(echo -n {2..} | wl-copy)+abort'
		--color header:italic
		--header 'Press CTRL-Y to copy command into clipboard'"

	export FZF_ALT_C_OPTS="
		--walker-skip .git,node_modules,target
		--preview 'tree {}'"
fi

if command -v zoxide &>/dev/null; then
	eval "$(zoxide init zsh --cmd cd)"
fi

if command -v eza &>/dev/null; then
	alias ls='eza'
	alias l='eza -l --group-directories-first'
	alias ll='eza -l --group-directories-first'
	alias llh='eza -lh --group-directories-first'
	alias lla='eza -la --group-directories-first'
	alias llha='eza -lha --group-directories-first'
	alias tree='eza --tree --group-directories-last'
else
	alias l='ls -l'
	alias ll='ls -l'
	alias llh='ls -lh'
	alias lla='ls -la'
	alias llha='ls -lha'
fi

